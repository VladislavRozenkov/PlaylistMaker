<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LinearLayoutStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="AppToolbarTitleStyle">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="ButtonStyleActivity" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>

        <item name="textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurface</item>

        <item name="iconGravity">textStart</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <style name="TextViewStyle">
        <item name="android:background">?attr/colorSurface</item>

        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>

        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textFontWeight">400</item>

        <item name="android:gravity">start|center_vertical</item>

        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>

        <item name="drawableTint">?attr/colorControlNormal</item>

        <item name="android:clickable">true</item>
    </style>

    <style name="TrackInfoTitle">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorControlNormal</item>
    </style>

    <style name="TrackInfoValue">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="PlaylistMakerTabTextAppearance"
        parent="TextAppearance.MaterialComponents.Button">

        <item name="android:textAllCaps">false</item>
    </style>

    <style name="PlaylistInputStyle"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">@color/playlist_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>

        <item name="boxCornerRadiusTopStart">4dp</item>
        <item name="boxCornerRadiusTopEnd">4dp</item>
        <item name="boxCornerRadiusBottomStart">4dp</item>
        <item name="boxCornerRadiusBottomEnd">4dp</item>

        <item name="android:textColorHint">?attr/colorControlNormal</item>
        <item name="hintTextColor">@color/blue</item>
        <item name="hintTextAppearance">@style/PlaylistHintStyle</item>

    </style>

    <style name="PlaylistHintStyle"
        parent="TextAppearance.MaterialComponents.Caption">

        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">12sp</item>

    </style>

</resources>